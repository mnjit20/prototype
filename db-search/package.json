{
  "name": "db-search",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Search MVP for the db teaching-materials catalog",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "ingest": "tsx src/ingest-cli.ts",
    "setup": "npm run migrate && npm run seed",
    "start:deploy": "npm start",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "pg": "^8.13.0",
    "tsx": "^4.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
